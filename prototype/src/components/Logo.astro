---
// Logo Matoulab — SVG inline (net à toute taille, 0 requête, 0 image à héberger).
// Badge dégradé + frimousse de chat minimaliste + mot-logo.
const { compact = false } = Astro.props;
---
<span class="logo">
  <svg class="logo-mark" width="34" height="34" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="mlg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#7c5cff" />
        <stop offset="1" stop-color="#b14bd6" />
      </linearGradient>
    </defs>
    <rect x="0" y="0" width="40" height="40" rx="11" fill="url(#mlg)" />
    <!-- oreilles -->
    <path d="M12 12 L12 21 L18 15 Z" fill="#fff" />
    <path d="M28 12 L28 21 L22 15 Z" fill="#fff" />
    <!-- tête -->
    <circle cx="20" cy="23" r="8.5" fill="#fff" />
    <!-- yeux -->
    <circle cx="17" cy="22" r="1.35" fill="#5a3ec8" />
    <circle cx="23" cy="22" r="1.35" fill="#5a3ec8" />
    <!-- museau -->
    <path d="M20 24.4 l1.6 1.4 a1.6 1.6 0 0 1 -3.2 0 Z" fill="#ff8fab" />
    <!-- moustaches -->
    <path d="M10.5 23 h4 M10.8 25.4 l3.8 -0.9 M29.5 23 h-4 M29.2 25.4 l-3.8 -0.9"
          stroke="#c9bfff" stroke-width="0.9" stroke-linecap="round" fill="none" />
  </svg>
  {!compact && <span class="logo-word">Matou<span class="logo-word-accent">lab</span></span>}
</span>
