---
import AuthorBox from '../components/AuthorBox.astro';
import UpdatedDate from '../components/UpdatedDate.astro';
import Disclaimer from '../components/Disclaimer.astro';

// Gabarit PAGE PILIER (tête de cocon). Hub thématique qui maille vers ses clusters.
// `clusters` = liste des articles enfants (slug + titre), injectée à la construction.
const { entry, clusters = [] } = Astro.props;
const d = entry.data;
---
<main class="pilier">
  <h1>{d.title}</h1>
  {d.cover && (
    <figure class="cover">
      <img src={d.cover} alt={d.coverAlt ?? d.title} width="1200" height="630" fetchpriority="high" />
    </figure>
  )}
  <UpdatedDate updatedAt={d.updatedAt} publishedAt={d.publishedAt} />
  <AuthorBox {...d.author} />
  {d.disclaimer && <Disclaimer />}

  <slot />  {/* introduction du pilier + sections */}

  {/* Cocon sémantique : la page pilier maille vers TOUS ses clusters, en cartes
     (image + titre + description) pour un rendu riche, jamais une page vide. */}
  {clusters.length > 0 && (
    <section class="cocon" aria-label="Articles de ce guide">
      <h2>Dans ce guide</h2>
      <ul class="article-cards">
        {clusters.map((c) => (
          <li>
            <a href={`/${c.slug}`}>
              {c.cover && (
                <span class="ac-img"><img src={c.cover} alt={c.coverAlt ?? c.title} width="860" height="484" loading="lazy" /></span>
              )}
              <span class="ac-body">
                <h3>{c.title}</h3>
                {c.description && <p>{c.description}</p>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</main>
