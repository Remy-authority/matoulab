---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page introuvable (404)" description="Cette page n'existe pas ou a été déplacée.">
  <main style="text-align:center; padding:4rem 1.5rem;">
    <p style="font-size:3rem; font-weight:800; margin:0; color:var(--brand);">404</p>
    <h1>Cette page est introuvable</h1>
    <p>Le lien est peut-être erroné ou la page a été déplacée.</p>
    <p style="margin-top:1.5rem;"><a class="btn" href="/">Retour à l'accueil</a></p>
  </main>
</BaseLayout>
